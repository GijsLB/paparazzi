<?xml version="1.0"?>
<!DOCTYPE flight_plan SYSTEM "../flight_plan.dtd">
<flight_plan alt="1.0" ground_alt="0" lat0="51.990634" lon0="4.376789" max_dist_from_home="10" name="MAV Course Exercise" security_height="0.4">

  <header>
    #include "modules/datalink/datalink.h"
    #include "modules/energy/electrical.h"
    #include "modules/radio_control/radio_control.h"
    #include "modules/ahrs/ahrs.h"
    #define NPS_GAZEBO_WORLD "cyberzoo_orange_poles.world"

    <!-- Gebruik de juiste header voor waypoints -->
    #include "modules/nav/waypoints.h"
    <!-- Voeg de conversie header toe voor fixed-point conversie -->
    #include "math/pprz_algebra_int.h"

    inline uint8_t SetWPAlt(uint8_t wp_id, float alt_m) {
      waypoint_set_alt_i(wp_id, POS_BFP_OF_REAL(alt_m));
      return 0;
    }
  </header>
  <waypoints>
    <waypoint lat="51.990631" lon="4.376796" name="HOME"/>
    <waypoint name="CLIMB" x="1.9" y="1.0"/>
    <waypoint name="STDBY" x="1.9" y="1.0"/>
    <waypoint name="TD" x="0.8" y="-1.7" height="0.5"/>
    <waypoint name="GOAL" x="1.9" y="1.0"/>
    <waypoint name="TRAJECTORY" x="1.9" y="1.0"/>
    <waypoint name="RETREAT" x="1.9" y="1.0"/>
    <waypoint lat="51.9905834" lon="4.3767710" name="_CZ1"/>
    <waypoint lat="51.9906440" lon="4.3767060" name="_CZ2"/>
    <waypoint lat="51.9906860" lon="4.3768080" name="_CZ3"/>
    <waypoint lat="51.9906238" lon="4.3768729" name="_CZ4"/>
    <waypoint lat="51.9906006" lon="4.3767764" name="_OZ1"/>
    <waypoint lat="51.9906405" lon="4.3767316" name="_OZ2"/>
    <waypoint lat="51.9906687" lon="4.3768025" name="_OZ3"/>
    <waypoint lat="51.9906273" lon="4.3768438" name="_OZ4"/>
  </waypoints>
  <sectors>
    <sector color="red" name="CyberZoo">
      <corner name="_CZ1"/>
      <corner name="_CZ2"/>
      <corner name="_CZ3"/>
      <corner name="_CZ4"/>
    </sector>
    <sector color="#FF9922" name="ObstacleZone">
      <corner name="_OZ1"/>
      <corner name="_OZ2"/>
      <corner name="_OZ3"/>
      <corner name="_OZ4"/>
    </sector>
  </sectors>
  <exceptions>
    <!-- GPS Lost (KILL Motors) -->
    <exception cond="((GpsIsLost() == true) @AND
      !(IndexOfBlock('Holding point') @GT nav_block) @AND
      !(nav_block >= IndexOfBlock('Emergency Landing')) @AND
      (autopilot_in_flight() == true) )" deroute="KILL"/>
    <!-- Datalink Lost -->
    <exception cond="((datalink_time @GT 2) @AND 
      !(IndexOfBlock('Holding point') @GT nav_block) @AND
      !(nav_block >= IndexOfBlock('Emergency Landing')) @AND
      (autopilot_in_flight() == true) )" deroute="Emergency Landing"/>
    <!-- Geofencing XY -->
    <exception cond="(!InsideCyberZoo(GetPosX(), GetPosY()) @AND
      !(IndexOfBlock('Holding point') @GT nav_block) @AND
      !(nav_block >= IndexOfBlock('Emergency Landing')) @AND
      (autopilot_in_flight() == true) )" deroute="Emergency Landing"/>
    <!-- Geofencing Z 3.5 -->
    <exception cond="((GetPosAlt() @GT 3.5) @AND
      !(IndexOfBlock('Holding point') @GT nav_block) @AND
      !(nav_block >= IndexOfBlock('Emergency Landing')) @AND
      (autopilot_in_flight() == true) )" deroute="Emergency Landing"/>
    <!-- Geofencing Z 4.5 -->
    <exception cond="((GetPosAlt() @GT 4.5) @AND
      !(IndexOfBlock('Holding point') @GT nav_block) @AND
      (autopilot_in_flight() == true) )" deroute="Emergency Landing"/>
    <!-- Bat Low -->
    <exception cond="(electrical.bat_low @AND
      !(IndexOfBlock('Holding point') @GT nav_block) @AND
      !(nav_block >= IndexOfBlock('Emergency Landing')) @AND
      (autopilot_in_flight() == true) )" deroute="Emergency Landing"/>
    <!-- Bat Critical -->
    <exception cond="(electrical.bat_critical @AND
      !(IndexOfBlock('Holding point') @GT nav_block) @AND
      !(nav_block >= IndexOfBlock('Emergency Landing')) @AND
      (autopilot_in_flight() == true) )" deroute="Emergency Landing"/>
  </exceptions>
  <blocks>
    <block name="Wait GPS">
      <call_once fun="NavKillThrottle()"/>
      <while cond="!GpsFixValid()"/>
    </block>
    <block name="Geo init">
      <while cond="LessThan(NavBlockTime(), 2)"/>
      <call_once fun="NavSetAltitudeReferenceHere()"/>
    </block>
    <block name="Holding point">
      <call_once fun="NavKillThrottle()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>
    <block key="r" name="Start Engine">
      <call_once fun="NavResurrect()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
      <call_once fun="NavResurrect()"/>
    </block>
    <block key="t" name="Takeoff" strip_button="Takeoff" strip_icon="takeoff.png">
      <call_once fun="NavSetWaypointHere(WP_TD)"/> 
      <exception cond="GetPosAlt() @GT 0.8" deroute="Standby"/>
      <call_once fun="NavSetWaypointHere(WP_CLIMB)"/>
      <stay climb="nav.climb_vspeed" vmode="climb" wp="CLIMB"/>
    </block>

    <!-- Standby block: changed to vmode="throttle" so we do NOT track waypoint's altitude -->
    <block key="s" name="Standby" strip_button="Standby" strip_icon="home.png">
      <call_once fun="NavSetWaypointHere(WP_STDBY)"/>
      <stay wp="STDBY"
            vmode="throttle"
            throttle="0.3"/>  <!-- Or whatever power you need horizontally -->
    </block>

    <!-- <block key="g" name="START" strip_button="Go" strip_icon="lookfore.png">
      <call_once fun="NavSetWaypointHere(WP_GOAL)"/>
      <stay wp="GOAL"/>
    </block> -->
    <!-- START block: we do a single 'go' to GOAL with vmode="throttle" so it won't override altitude. -->
    <block key="g" name="START" strip_button="Go" strip_icon="lookfore.png">
      <call_once fun="NavSetWaypointHere(WP_GOAL)"/>
      <!-- Replace the 'NavGotoWaypoint(WP_GOAL)' call with a flight plan go command: -->
      <go wp="GOAL"
          vmode="throttle"
          throttle="0.3"
          pitch = "10"/>
      <!-- remain in this block, letting your module handle altitude -->
      <while cond="TRUE"/>
    </block>

    <!-- STOP block: again no altitude override, so let's do vmode="throttle" -->
    <block name="STOP">
      <call_once fun="NavSetWaypointHere(WP_STDBY)"/>
      <stay wp="STDBY"
            vmode="throttle"
            throttle="0.3"/>
    </block>

    <!-- RETREAT block, same logic if you want to keep altitude from the module -->
    <block name="RETREAT">
      <exception cond="block_time @GT 2.0" deroute="STOP"/>
      <call_once fun="NavSetWaypointHere(WP_RETREAT)"/>
      <stay wp="RETREAT"
            vmode="throttle" throttle="0.3"/>
    </block>

    <block key="e" name="Emergency Landing">
      <exception cond="!nav_is_in_flight()" deroute="KILL"/>
      <exception cond="0.10 @GT GetPosAlt()" deroute="KILL"/>
      <call_once fun="NavSetWaypointHere(WP_TD)"/>
      <call_once fun="NavStartDetectGround()"/>
      <!-- still do vmode="climb" to descend quickly -->
      <stay climb="-1.25" vmode="climb" wp="TD"/>
    </block>

    <block key="i" name="Immediate Landing" strip_button="Immediate Landing" strip_icon="land-right.png">
      <call_once fun="NavSetWaypointHere(WP_TD)"/>
      <deroute block="Land"/>
    </block>

    <block key="l" name="Land">
      <exception cond="0.55 @GEQ GetPosAlt()" deroute="Flare"/>
      <exception cond="block_time @GT 5" deroute="Flare"/>
      <go wp="TD"/>
      <deroute block="Flare"/>
    </block>

    <block name="Flare">
      <exception cond="!nav_is_in_flight()" deroute="Landed"/>
      <exception cond="0.10 @GT GetPosAlt()" deroute="Landed"/>
      <call_once fun="NavStartDetectGround()"/>
      <stay climb="nav.descend_vspeed" vmode="climb" wp="TD"/>
    </block>

    <block name="Landed">
      <call_once fun="NavKillThrottle()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>

    <block name="KILL">
      <call_once fun="autopilot_set_mode(AP_MODE_KILL)"/>
      <call_once fun="NavKillThrottle()"/>
      <attitude pitch="0" roll="0" throttle="0" until="FALSE" vmode="throttle"/>
    </block>

    <block name="Oscillation">
      <call fun="SetWPAlt(WP_GOAL, 2.0)"/>
      <!-- Blijf hier tot 3s voorbij is -->
      <stay wp="GOAL" vmode="alt" until="(stage_time @GT 0.1)"/>

      <!-- Daarna WP_GOAL op 0.2 m -->
      <call fun="SetWPAlt(WP_GOAL, 1.0)"/>
      <!-- Blijf hier tot 3s voorbij is -->
      <stay wp="GOAL" vmode="alt" until="(stage_time @GT 0.1)"/>
      <!-- Oneindige lus -->
      <deroute block="Oscillation"/>
    </block>



  </blocks>
</flight_plan>
